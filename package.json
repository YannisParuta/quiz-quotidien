{
  "name": "quiz-quotidien",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild src/app.jsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/assets/app.js",
    "build:css": "tailwindcss -i src/styles.css -o public/assets/app.css --minify"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19"
  }
}
